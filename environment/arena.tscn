size = Vector3(80, 34, 3)

[sub_resource type="BoxShape3D" id="shape_goal"]
size = Vector3(80, 36, 30)

; recessed goal-trigger shape: depth 24, sits behind the mouth so the ball must
; fully cross the goal line (mouth plane) before the Area3D fires.
[sub_resource type="BoxShape3D" id="shape_goal_trigger"]
size = Vector3(80, 36, 24)

[sub_resource type="BoxShape3D" id="shape_goal_back"]
size = Vector3(80, 36, 3)

[sub_resource type="BoxShape3D" id="shape_goal_side"]
size = Vector3(3, 36, 30)

[sub_resource type="BoxShape3D" id="shape_goal_roof"]
size = Vector3(80, 3, 30)

; --- ceiling + filleted corners (no 90° edges, rocket-league style) ---
[sub_resource type="BoxMesh" id="mesh_ceiling"]
material = SubResource("wall_mat")
size = Vector3(240, 3, 400)

[sub_resource type="BoxShape3D" id="shape_ceiling"]
size = Vector3(240, 3, 400)

; thin 45° ramp panels: each spans flush from floor/wall to the adjacent surface
; so the bevel sits inside the arena with no geometry poking through the walls.
