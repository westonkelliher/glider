[gd_scene load_steps=30 format=3 uid="uid://co2dvg8udnvto"]

[ext_resource type="Script" path="res://environment/referee.gd" id="1_ref"]

; Rocket-league-style arena: walls visible only from the inside (front-culled,
; semi-transparent), with a goal-shaped opening in each end wall. Goal zones are
; Area3D regions (shape + collision only, no functionality).

[sub_resource type="StandardMaterial3D" id="wall_mat"]
transparency = 1
albedo_color = Color(0.55, 0.75, 1, 0.32)
roughness = 0.4

[sub_resource type="StandardMaterial3D" id="goal_blue_mat"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.45)

[sub_resource type="StandardMaterial3D" id="goal_orange_mat"]
transparency = 1
albedo_color = Color(1, 0.5, 0.15, 0.45)

; --- goal-line markers: bright unshaded strips on the floor at each mouth plane ---
[sub_resource type="StandardMaterial3D" id="line_blue_mat"]
shading_mode = 0
albedo_color = Color(0.3, 0.6, 1, 1)
emission_enabled = true
emission = Color(0.3, 0.6, 1, 1)
emission_energy_multiplier = 2.0

[sub_resource type="StandardMaterial3D" id="line_orange_mat"]
shading_mode = 0
albedo_color = Color(1, 0.55, 0.15, 1)
emission_enabled = true
emission = Color(1, 0.55, 0.15, 1)
emission_energy_multiplier = 2.0

[sub_resource type="BoxMesh" id="mesh_line_north"]
material = SubResource("line_blue_mat")
size = Vector3(80, 0.1, 0.5)

[sub_resource type="BoxMesh" id="mesh_line_south"]
material = SubResource("line_orange_mat")
size = Vector3(80, 0.1, 0.5)

